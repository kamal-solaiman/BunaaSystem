###############################################################################
# Bunaa System — Environment Template
#
# Non-secret template only (AI_DOCS/35_Environment_Configuration.md §10.1).
# Real values live in the deployment-managed .env, which is never committed.
# Copy to .env and generate APP_KEY with: php artisan key:generate
###############################################################################

# --- Application identity ----------------------------------------------------
APP_NAME="Bunaa System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com/113

# Arabic is the default language; English is fully supported.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# Per-Teacher timezone and currency remain PENDING (Q-015). UTC is the
# application baseline and must not be treated as a resolved product decision.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=1
BCRYPT_ROUNDS=12

# --- Database (MySQL 8, InnoDB, utf8mb4) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Framework drivers (fixed by confirmed decisions D-040…D-043) ------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log

# --- Authentication ----------------------------------------------------------
# Domains trusted for Sanctum stateful (cookie) authentication.
SANCTUM_STATEFUL_DOMAINS=example.com

# --- Logging -----------------------------------------------------------------
# File-based logging, compatible with cPanel Shared Hosting.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Mail (SMTP transport baseline only) -------------------------------------
# Transport availability only. This does NOT enable notification features,
# which are out of scope for Version 1 (D-012).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (browser-safe public values only) ------------------------------
# Vite exposes only VITE_-prefixed variables to the browser bundle. Never place
# a secret, credential, storage path, or authorization decision here.
VITE_API_BASE_URL=/api/v1
